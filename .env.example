# GraphGuard Environment Configuration Template
GRAPHGUARD_ENV=development
LOG_LEVEL=INFO

# Message Bus (Redpanda / Kafka)
KAFKA_BOOTSTRAP_SERVERS=localhost:9092
KAFKA_INTERNAL_SERVERS=redpanda:29092

# Storage (TimescaleDB / PostgreSQL 16)
POSTGRES_HOST=localhost
POSTGRES_PORT=5432
POSTGRES_DB=graphguard
POSTGRES_USER=graphguard
POSTGRES_PASSWORD=graphguard_dev

# Cache & Lock State (Redis)
REDIS_HOST=localhost
REDIS_PORT=6379

# Enforcer Mode (DryRunEnforcer by default per Rule 7)
DEFAULT_ENFORCER=DryRunEnforcer
